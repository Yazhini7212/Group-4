# Images never go into git (raw downloads, cache): too large, and the
# releases' licences do not allow re-publishing them. The small metadata
# tables (index, provenance manifests) are tracked so the group shares them.
data/*
!data/index/
!data/manifests/
logs/
*.zip
*.dcm
# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
# Credentials
kaggle.json
.env
*.egg-info/
build/
# VS Code: share the project settings, keep personal ones private
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
